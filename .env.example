APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- M-Pesa (Safaricom Daraja) ---
# Use MPESA_DRIVER=fake for local development (payments succeed instantly).
# Use MPESA_DRIVER=daraja with sandbox credentials from https://developer.safaricom.co.ke
MPESA_DRIVER=fake
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Must be public HTTPS (e.g. your domain or an ngrok URL); defaults to APP_URL
MPESA_CALLBACK_BASE_URL=
# Long random string, e.g. output of: php -r "echo bin2hex(random_bytes(20));"
MPESA_CALLBACK_SECRET=

# --- Marketplace rules ---
TIXSWAP_COMMISSION_PERCENT=10
# Max resale price as % above face value (leave empty for no cap)
TIXSWAP_MAX_MARKUP_PERCENT=20
TIXSWAP_RESERVATION_MINUTES=10
TIXSWAP_ESCROW_RELEASE_HOURS=24
# Sellers with fewer completed sales are "new" and wait extra hours for payouts
TIXSWAP_TRUSTED_SELLER_SALES=3
TIXSWAP_NEW_SELLER_EXTRA_HOLD_HOURS=48

# --- SMS notifications (Africa's Talking) ---
# log = write SMS to the log (default); africastalking = send for real; empty = off
SMS_DRIVER=log
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
